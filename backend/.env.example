# LLM Provider Configuration
# Choose from: openai, anthropic, gemini, mistral, ollama
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here

# Embedding Provider Configuration
# Choose from: openai, sentence-transformers
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_api_key_here

# Database Configuration
DATABASE_URL=postgresql://admin:password@localhost:5432/legal_analyzer

# Auth
JWT_SECRET_KEY=your_super_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
